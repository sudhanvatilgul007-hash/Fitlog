# Railway Fitlog service variables. Attach a persistent volume at /data first.
# Alternatively use the Railway PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:////data/fitlog.db
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-nano
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=https://fitlog-production-057f.up.railway.app
FRONTEND_URL=https://fitlog-production-057f.up.railway.app
# gpt-4.1-nano is scheduled to retire on 2026-10-23.
